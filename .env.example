# 复制为 .env 并填值;.env 已被 .gitignore 排除。
# 前缀固定为 KBMESH_(见 core/config.py);FEATURE_* 前缀为 KBMESH_FEATURE_*。
# 空值 = 该能力关闭或降级(代码必须能带着空 key 跑通离线逻辑与测试)。

KBMESH_ENV=dev
KBMESH_SECRET_KEY=
KBMESH_JWT_SECRET=
KBMESH_JWT_ALGORITHM=HS256
KBMESH_ACCESS_TOKEN_TTL_MIN=120
# 登录失败节流:按 (来源 IP, 账号) 计数;合法口令永远放行,不会因刷错密码锁死账号
KBMESH_LOGIN_MAX_FAILURES=5
# 单来源 IP 预检上限:达到后直接 429,不再执行 bcrypt
KBMESH_LOGIN_IP_MAX_FAILURES=20
KBMESH_LOGIN_WINDOW_SECONDS=300
# 只有来自这些反向代理的 X-Forwarded-For 才可信;逗号分隔,留空 = 只信 socket 对端
KBMESH_TRUSTED_PROXIES=
# 请求体/单文档上限(字节),ASGI 层在解析表单前兜底
KBMESH_MAX_DOCUMENT_BYTES=52428800

# --- 关系库(dev 指向部署环境的 PostgreSQL;测试库务必用 *_test 库) ---
KBMESH_DB_URL=postgresql+asyncpg://dev:YOUR_PASSWORD@postgres.example.com:5432/kbmesh
KBMESH_TEST_DB_URL=postgresql+asyncpg://dev:YOUR_PASSWORD@postgres.example.com:5432/kbmesh_test
KBMESH_CHECKPOINT_SCHEMA=lg

# --- Redis / Celery ---
KBMESH_REDIS_URL=redis://:YOUR_PASSWORD@redis.example.com:6379/5
KBMESH_CELERY_BROKER_URL=redis://:YOUR_PASSWORD@redis.example.com:6379/5
KBMESH_CELERY_RESULT_BACKEND=redis://:YOUR_PASSWORD@redis.example.com:6379/6

# --- 检索引擎(本机 Docker,只绑 127.0.0.1;deploy/.env 里另有容器口令) ---
KBMESH_MILVUS_URI=http://127.0.0.1:19530
KBMESH_MILVUS_TOKEN=
KBMESH_MILVUS_DB=default
KBMESH_MILVUS_COLLECTION=kb_chunk_index
KBMESH_NEO4J_URI=bolt://127.0.0.1:7687
KBMESH_NEO4J_USER=neo4j
KBMESH_NEO4J_PASSWORD=

# --- 对象存储(业务原图/解析产物,部署环境的 MinIO;path-style + http) ---
KBMESH_OSS_ENDPOINT=http://minio.example.com:9000
KBMESH_OSS_ACCESS_KEY_ID=
KBMESH_OSS_SECRET_ACCESS_KEY=
KBMESH_OSS_BUCKET=kbmesh-artifact
KBMESH_OSS_ADDRESSING=path

# --- 模型网关(百炼,只读:chat/embedding/rerank,不写托管知识库) ---
# 换 embedding 模型 = 重建 Milvus collection:dense 维度在建集合时定死,
# 且新旧模型的向量空间不互通,老索引必须整库重放(走 §5 离线管道,不能改一半)。
KBMESH_DASHSCOPE_API_KEY=sk-xxx
KBMESH_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KBMESH_LLM_MODEL=qwen3.8-flash
KBMESH_ROUTER_MODEL=qwen3.8-flash
KBMESH_VISION_MODEL=qwen3.8-omni-flash
KBMESH_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
KBMESH_EMBEDDING_DIM=1024
KBMESH_RERANK_MODEL=qwen3.7-text-rerank
# 思考模式默认关:实测 2 字回复会计费 29 个 reasoning token(in 也从 30 涨到 66)
KBMESH_LLM_ENABLE_THINKING=0
KBMESH_LLM_MAX_CONCURRENCY=4
KBMESH_LLM_TIMEOUT_S=60
KBMESH_LLM_MAX_RETRIES=2

# --- 检索阈值与预算(可被请求级 config 覆盖) ---
KBMESH_TOP_K_ROUTE=50
KBMESH_TOP_K_GRAPH=30
KBMESH_TOP_K_FUSION=30
KBMESH_TOP_N_CONTEXT=8
KBMESH_RRF_K=60
KBMESH_THETA_REL=0.35
KBMESH_THETA_ANSWER=0.45
KBMESH_MAX_TARGETED_RETRY=2
# 只能是 1/2/3:变长路径不可参数化,跳数走白名单
KBMESH_GRAPH_MAX_HOPS=2
KBMESH_GRAPH_MAX_EDGES=30
KBMESH_PENDING_CONFIRM_TTL_MIN=30
KBMESH_ONLINE_EVAL_SAMPLE_RATE=0.1
KBMESH_REGRESSION_GATE=-0.02

# --- 降级开关:必需项(意图路由 / 正文 BM25 / 检查点)不可关,故不在此列 ---
KBMESH_FEATURE_ROUTE_HEADING=1
KBMESH_FEATURE_ROUTE_GRAPH=1
KBMESH_FEATURE_RERANK=1
KBMESH_FEATURE_CROSSCHECK=1
KBMESH_FEATURE_ONLINE_EVAL=1

# --- 观测 ---
KBMESH_TRACE_PERSIST=1
